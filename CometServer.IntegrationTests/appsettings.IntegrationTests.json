{
  "Midtier": {
    "UploadDirectory": "upload",
    "FileStorageDirectory": "storage",
    "TemporaryFileStorageDirectory": "tempstorage",
    "IsExportEnabled": true,
    "ExportDirectory": "export",
    "BacktierWaitTime": 60
  },
  "Backtier": {
    "HostName": "localhost",
    "Port": 5432,
    "UserName": "cdp4",
    "Password": "cdp4",
    "Database": "cdp4server",
    "DatabaseRestore": "cdp4serverrestore",
    "DatabaseManage": "cdp4manage",
    "StatementTimeout": 180,
    "ConnectionTimeout": 15,
    "Keepalive": 0,
    "MaximumPoolSize": 90,
    "IsDbSeedEnabled": true,
    "IsDbRestoreEnabled": true,
    "IsDbImportEnabled": false,
    "SslMode": "Disable",
    "RootCertificate": "",
    "ClientCertificate": "",
    "ClientCertificateKey": "",
    "ClientCertificatePassword": "",
    "CheckCertificateRevocation": false
  },
  "MessageBroker": {
    "IsEnabled": false,
    "HostName": "localhost",
    "Port": 5672
  },
  "EmailService": {
    "Sender": "CDP4-COMET",
    "SMTP": "localhost",
    "Port": 587,
    "UserName": "",
    "Password": ""
  },
  "Defaults": {
    "PersonPassword": "pass"
  },
  "Changelog": {
    "CollectChanges": false,
    "AllowEmailNotification": false
  },
  "Health": {
    "RequireHost": []
  },
  "LongRunningTasks": {
    "RetentionTime": 3600
  },
  "Authentication": {
    "Basic": {
      "IsEnabled": true
    },
    "LocalJwtBearer": {
      "IsEnabled": false,
      "ValidIssuer": "CDP4-COMET",
      "ValidAudience": "localhost",
      "SymmetricSecurityKey": "integration-tests-only-symmetric-security-key",
      "TokenExpirationMinutes": 5,
      "RefreshExpirationMinutes": 15
    },
    "ExternalJwtBearer": {
      "IsEnabled": false,
      "ValidIssuer": "",
      "ValidAudience": "",
      "Authority": "",
      "IdentifierClaimName": "",
      "PersonIdentifierPropertyKind": "ShortName",
      "ClientId": ""
    }
  }
}
